# Ganti PASSWORD dengan password user postgres lokal kamu.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/bumdes_maju_jaya?schema=public"

# Rahasia JWT, min 32 karakter acak. Contoh generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NUXT_JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Password akun admin awal saat seed (ganti setelah login).
SEED_ADMIN_PASSWORD="admin12345"
