# Ganti PASSWORD dengan password user postgres lokal kamu.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/bumdes_maju_jaya?schema=public"

# Rahasia JWT, min 32 karakter acak. Contoh generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NUXT_JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Akun admin awal saat seed (ganti password setelah login).
SEED_ADMIN_EMAIL="admin@kalibakung.desa.id"
SEED_ADMIN_PASSWORD="admin12345"

# --- Email verifikasi (Gmail SMTP) ---
# GMAIL_USER = akun Gmail pengirim link verifikasi (contoh: desa.kalibakung@gmail.com)
# GMAIL_APP_PASSWORD = App Password Gmail (bukan password login biasa).
#   Cara buat: Google Account > Security > 2-Step Verification aktif > App passwords.
#   Bila keduanya kosong, link verifikasi dicetak di console server (mode uji lokal).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# URL dasar aplikasi untuk link verifikasi (ganti saat produksi).
APP_URL="http://localhost:3000"
